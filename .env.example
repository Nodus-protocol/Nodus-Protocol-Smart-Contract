# ── Stellar Deploy Config ─────────────────────────────────────────────────────
# Your Stellar account secret key (used to deploy and invoke the contract).
# Never commit the real value — add .env to .gitignore.
STELLAR_SECRET_KEY=S...

# ── Network ───────────────────────────────────────────────────────────────────
# "testnet" or "mainnet"
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Token Addresses ───────────────────────────────────────────────────────────
# SEP-41 token contract IDs for the two pool assets.
POOL_TOKEN_0=                  # XLM contract address
POOL_TOKEN_1=                  # USDC contract address

# ── Deployed Contract ─────────────────────────────────────────────────────────
# Set after first deployment; required for upgrade and invoke scripts.
POOL_CONTRACT_ID=
